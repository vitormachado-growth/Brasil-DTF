{
  // Publicação na Cloudflare (Workers com arquivos estáticos).
  //
  // O site é exportado como arquivos por `npm run build` (next.config.ts tem
  // `output: "export"`), então não há código de servidor aqui: este arquivo só
  // diz ao wrangler onde estão os arquivos prontos.
  //
  // Sem ele o deploy falha com "Could not detect a directory containing
  // static files", que é exatamente o que acontece quando o wrangler roda sem
  // saber o que publicar.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brasil-dtf",
  "compatibility_date": "2026-09-13",

  "assets": {
    // Relativo a este arquivo, ou seja `site/out`.
    "directory": "./out",

    // URL sem extensão é resolvida para o .html correspondente, que é como
    // /maquinas/702e-c650sc chega em 702e-c650sc.html.
    "html_handling": "auto-trailing-slash",

    // Endereço que não existe cai na página 404 do próprio site, e não numa
    // tela genérica da Cloudflare. Não usar "single-page-application" aqui:
    // este site tem várias páginas de verdade, uma por máquina.
    "not_found_handling": "404-page"
  }
}
